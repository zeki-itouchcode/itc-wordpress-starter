{
  "name": "@itouchcode/wordpress-starter",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.9.0",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "workspaces": [
    "packages/mu-plugins/*",
    "packages/plugins/*",
    "packages/themes/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "start": "turbo run start"
  },
  "devDependencies": {
    "@wordpress/scripts": "^31.8.0",
    "prettier": "^3.8.1",
    "turbo": "^2.8.11",
    "typescript": "~5.9.3"
  }
}
