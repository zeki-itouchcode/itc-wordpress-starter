{
  "name": "itouchcode/wordpress-starter",
  "type": "project",
  "license": "MIT",
  "description": "A Composer-based WordPress starting point for building editable websites.",
  "keywords": [
    "wordpress",
    "composer",
    "bedrock"
  ],
  "repositories": [
    {
      "type": "path",
      "url": "packages/themes/*",
      "options": {
        "symlink": true
      }
    },
    {
      "type": "path",
      "url": "packages/plugins/*",
      "options": {
        "symlink": true
      }
    },
    {
      "type": "path",
      "url": "packages/mu-plugins/*",
      "options": {
        "symlink": true
      }
    },
    {
      "name": "wp-packages",
      "type": "composer",
      "url": "https://repo.wp-packages.org"
    }
  ],
  "require": {
    "composer/installers": "^2.0",
    "itouchcode/itc-starter-theme": "^1.0",
    "oscarotero/env": "^2.0",
    "php": ">=8.3",
    "roots/bedrock-autoloader": "^1.0",
    "roots/bedrock-disallow-indexing": "^2.0",
    "roots/wordpress": "7.1.4",
    "roots/wp-config": "^1.0",
    "vlucas/phpdotenv": "^5.0"
  },
  "require-dev": {
    "laravel/pint": "^1.0",
    "pestphp/pest": "^4.0"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "allow-plugins": {
      "composer/installers": true,
      "roots/wordpress-core-installer": true,
      "pestphp/pest-plugin": true
    },
    "sort-packages": true
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "extra": {
    "installer-paths": {
      "public/content/mu-plugins/{$name}/": [
        "type:wordpress-muplugin"
      ],
      "public/content/plugins/{$name}/": [
        "type:wordpress-plugin"
      ],
      "public/content/themes/{$name}/": [
        "type:wordpress-theme"
      ]
    },
    "wordpress-install-dir": "public/wp"
  },
  "scripts": {
    "lint": "pint --test",
    "lint:fix": "pint",
    "test": "pest"
  }
}
